# Obsidian. The repo root is the vault. Commit the settings that make authoring and
# committing work; ignore machine-specific state (window layout, theme, caches) and
# the Git plugin's own 700KB bundle — install that from Obsidian's community plugin
# browser on another machine, and these committed settings will configure it.
.obsidian/*
!.obsidian/app.json
!.obsidian/core-plugins.json
!.obsidian/community-plugins.json
!.obsidian/plugins/
.obsidian/plugins/*
!.obsidian/plugins/obsidian-git/
.obsidian/plugins/obsidian-git/*
!.obsidian/plugins/obsidian-git/data.json
