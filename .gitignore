node_modules/
.DS_Store
tsconfig.tsbuildinfo

# The vault is content/. A stray .obsidian at the repo root just means Obsidian was
# opened here by mistake; it holds no settings this site needs.
/.obsidian/

# Quartz build output and caches
public/
.quartz-cache/
quartz/.quartz-cache/

# Generated image derivatives — regenerated by `npm run build`, never edited by hand
content/assets/derived/

# Planning documents and working notes: kept locally, deliberately not published.
# NOTES.md no longer exists — the README now covers how the site works, and its open
# questions are closed. The rule stays, so that recreating the file can't publish it.
portfolio-site-plan.md
claude-code-build-brief.md
NOTES.md

# Obsidian. The vault is content/. Commit the settings that make authoring and
# committing work; ignore machine-specific state (window layout, theme) and the Git
# plugin's own 700KB bundle — install that from Obsidian's community plugin browser
# on another machine and these committed settings will configure it.
content/.obsidian/*
!content/.obsidian/app.json
!content/.obsidian/core-plugins.json
!content/.obsidian/community-plugins.json
!content/.obsidian/plugins/
content/.obsidian/plugins/*
!content/.obsidian/plugins/obsidian-git/
content/.obsidian/plugins/obsidian-git/*
!content/.obsidian/plugins/obsidian-git/data.json
