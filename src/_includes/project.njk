---
layout: base.njk
ogType: article
---
<article class="project">
  <header class="project__header">
    {%- if draft %}
    <p class="draft-flag">Draft — not published. Facts in this entry still need confirming.</p>
    {%- endif %}
    <h1>{{ title }}</h1>
    {%- if summary %}
    <p class="project__summary">{{ summary | inlineMarkdown | safe }}</p>
    {%- endif %}
    {%- if year or tools.length %}
    <dl class="meta">
      {%- if year %}
      <dt>Year</dt>
      <dd>{{ year }}</dd>
      {%- endif %}
      {%- if tools.length %}
      <dt>Tools</dt>
      <dd>{{ tools | join(", ") }}</dd>
      {%- endif %}
    </dl>
    {%- endif %}
  </header>

  {%- set h = hero or {} %}
  <div class="hero">
    {%- if h.video %}
    {% video h.video, h.poster, h.alt or title %}
    {%- else %}
    {% hero h, title %}
    {%- endif %}
  </div>

  {%- for section in sections | filledSections %}
  <section class="project__section">
    <h2>{{ section.heading }}</h2>
    {{ section.body | safe }}
  </section>
  {%- endfor %}

  {%- if content | hasText %}
  <div class="project__body">
    {{ content | safe }}
  </div>
  {%- endif %}

  {%- set liveLinks = links | withUrl %}
  {%- if liveLinks.length %}
  <section class="project__section">
    <h2>Links</h2>
    <ul class="link-list">
      {%- for link in liveLinks %}
      <li><a href="{{ link.url }}">{{ link.label or link.url }}</a></li>
      {%- endfor %}
    </ul>
  </section>
  {%- endif %}

  <p class="back-link"><a href="/work/">All work</a></p>
</article>
